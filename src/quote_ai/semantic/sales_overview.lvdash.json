{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "Headline measures",
      "queryLines": [
        "SELECT MEASURE(quotes) AS quotes, MEASURE(win_rate) AS win_rate, ",
        "MEASURE(avg_discount_pct) AS avg_discount_pct, MEASURE(quote_turnaround_h) AS quote_turnaround_h, ",
        "MEASURE(approval_rate) AS approval_rate ",
        "FROM quote_metrics WHERE (:account = 'All' OR account = :account)"
      ],
      "parameters": [
        {
          "displayName": "Account",
          "keyword": "account",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "pipeline_by_state",
      "displayName": "Pipeline by state",
      "queryLines": [
        "SELECT state, MEASURE(quotes) AS quotes FROM quote_metrics WHERE (:account = 'All' OR account = :account) GROUP BY state"
      ],
      "parameters": [
        {
          "displayName": "Account",
          "keyword": "account",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "win_rate_by_region",
      "displayName": "Win rate by region",
      "queryLines": [
        "SELECT region, MEASURE(win_rate) AS win_rate FROM quote_metrics WHERE (:account = 'All' OR account = :account) GROUP BY region"
      ],
      "parameters": [
        {
          "displayName": "Account",
          "keyword": "account",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "win_rate_by_month",
      "displayName": "Win rate by month and product family",
      "queryLines": [
        "SELECT month, product_family, MEASURE(win_rate) AS win_rate FROM quote_metrics WHERE (:account = 'All' OR account = :account) ",
        "GROUP BY month, product_family"
      ],
      "parameters": [
        {
          "displayName": "Account",
          "keyword": "account",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "account_purchases",
      "displayName": "What the account bought, and at what price",
      "queryLines": [
        "SELECT month, sku, MEASURE(units) AS units, MEASURE(avg_unit_price) AS avg_unit_price FROM order_metrics ",
        "WHERE (:account = 'All' OR account = :account) GROUP BY month, sku"
      ],
      "parameters": [
        {
          "displayName": "Account",
          "keyword": "account",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        }
      ]
    }
  ],
